{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@screens": ["./src/screens"],
      "@components": ["./src/components"],
      "@assets": ["./src/assets"],
      "@configs": ["./src/configs"],
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
