{
  "git": {
    "commit": true,
    "commitMessage": "chore: release ${name} ${tag}",
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true,
    "requireBranch": "main",
    "requireCleanWorkingDir": false,
    "requireUpstream": true,
    "addUntrackedFiles": false,
    "commitArgs": ["--no-verify"]
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": null,
    "autoGenerate": true,
    "draft": false,
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": {
    "publish": true,
    "publishPath": ".",
    "ignoreVersion": false,
    "skipChecks": false
  },
  "hooks": {
    "after:release": [
      "echo ''",
      "echo '🎉 Release ${version} completed successfully!'",
      "echo ''",
      "echo '📦 Package: ${name}@${version}'",
      "echo '🔗 npm: https://www.npmjs.com/package/${name}/v/${version}'",
      "echo '🔗 GitHub: ${github.releaseUrl}'",
      "echo ''",
      "echo 'Install with: npm install ${name}@${version}'"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "angular"
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "ignoreRecommendedBump": false
    }
  }
}
