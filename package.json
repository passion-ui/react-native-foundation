{
  "name": "react-native-foundation-monorepo",
  "private": true,
  "description": "React Native Foundation - Monorepo workspace",
  "scripts": {
    "clean": "rm -rf node_modules yarn.lock example/node_modules packages/*/node_modules packages/*/lib",
    "all": "yarn clean && yarn install && yarn build:foundation",
    "build:foundation": "yarn workspace @passionui/react-native-foundation build",
    "clean:foundation": "yarn workspace @passionui/react-native-foundation clean",
    "typecheck:foundation": "yarn workspace @passionui/react-native-foundation typecheck",
    "example": "yarn workspace example start",
    "workspaces:info": "yarn workspaces info",
    "release:foundation:latest": "cd packages/foundation && npx release-it --ci patch",
    "release:foundation:beta": "cd packages/foundation && npx release-it --ci --preRelease=beta",
    "release:foundation:alpha": "cd packages/foundation && npx release-it --ci --preRelease=alpha"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passion-ui/react-native-foundation.git"
  },
  "author": "Dũng (Wem) <huynh.developer@gmail.com> (https://github.com/wem2017)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/passion-ui/react-native-foundation/issues"
  },
  "homepage": "https://github.com/passion-ui/react-native-foundation#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": {
    "packages": [
      "example",
      "packages/*"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@release-it-plugins/workspaces": "^5.0.3",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^5.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.13",
    "release-it": "^19.0.4",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
