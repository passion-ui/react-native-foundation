{
  "name": "react-native-foundation-monorepo",
  "private": true,
  "description": "React Native Foundation - Monorepo workspace",
  "scripts": {
    "build": "npm run build --workspace=@passionui/react-native-foundation",
    "clean": "npm run clean --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --ignore-pattern \"**/node_modules/**\" --ignore-pattern \"**/lib/**\"",
    "example": "npm start --workspace=example",
    "prepare": "npm run build",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passion-ui/react-native-foundation.git"
  },
  "author": "Dũng (Wem) <huynh.developer@gmail.com> (https://github.com/wem2017)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/passion-ui/react-native-foundation/issues"
  },
  "homepage": "https://github.com/passion-ui/react-native-foundation#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "example",
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@evilmartians/lefthook": "^1.12.3",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "^0.81.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/tinycolor2": "1.4.6",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "react-native-builder-bob": "^0.40.13",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
