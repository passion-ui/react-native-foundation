{
  "name": "react-native-foundation-monorepo",
  "private": true,
  "description": "React Native Foundation - Monorepo workspace",
  "scripts": {
    "build:foundation": "npm run build --workspace=@passionui/react-native-foundation",
    "clean:foundation": "npm run clean --workspace=@passionui/react-native-foundation",
    "typecheck:foundation": "npm run typecheck --workspace=@passionui/react-native-foundation",
    "example": "npm start --workspace=example",
    "release:foundation": "npm run build:foundation && cd packages/foundation && release-it",
    "release:foundation:beta": "npm run build:foundation && cd packages/foundation && release-it --preRelease=beta",
    "release:foundation:patch": "npm run build:foundation && cd packages/foundation && release-it patch",
    "release:foundation:minor": "npm run build:foundation && cd packages/foundation && release-it minor",
    "release:foundation:major": "npm run build:foundation && cd packages/foundation && release-it major"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passion-ui/react-native-foundation.git"
  },
  "author": "Dũng (Wem) <huynh.developer@gmail.com> (https://github.com/wem2017)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/passion-ui/react-native-foundation/issues"
  },
  "homepage": "https://github.com/passion-ui/react-native-foundation#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "example",
    "packages/*"
  ],
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "prettier": "^3.6.2",
    "react-native-builder-bob": "^0.40.13",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
